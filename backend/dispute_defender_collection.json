      "item": [
        {
          "name": "Ingest Webhook - payment.dispute.created (Nested Structure)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"payment.dispute.created\",\n  \"payload\": {\n    \"dispute\": {\n      \"entity\": {\n        \"id\": \"disp_test_998811\",\n        \"payment_id\": \"pay_test_445566\",\n        \"reason_code\": \"goods_not_delivered\",\n        \"amount\": 149900\n      }\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/webhook/razorpay",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "webhook",
                "razorpay"
              ]
            },
            "description": "Primary webhook endpoint ingesting Razorpay dispute creation events using the nested payload model structure."
          },
          "response": []
        },
