    {
      "name": "Disputes & Database Fetch",
      "description": "Endpoints for querying disputes, metrics, manual operator overrides, and synthetic testing.",
      "item": [
        {
          "name": "Get Metrics & ROI Summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/metrics",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "metrics"
              ]
            },
            "description": "Fetch financial analytics: net INR saved, win rate, avoided bank penalties, and dispute counts."
          },
          "response": []
        },
        {
          "name": "List Disputes (Paginated)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/disputes?skip=0&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "disputes"
              ],
              "query": [
                {
                  "key": "skip",
                  "value": "0",
                  "description": "Pagination offset"
                },
                {
                  "key": "limit",
                  "value": "20",
                  "description": "Pagination limit"
                },
                {
                  "key": "status",
                  "value": "under_review",
                  "description": "Filter by dispute status",
                  "disabled": true
                },
                {
                  "key": "search",
                  "value": "disp_",
                  "description": "Search by dispute ID, payment ID, or reason code",
                  "disabled": true
                }
              ]
            },
            "description": "Retrieve paginated list of disputes from the database with optional status filtering and search."
          },
          "response": []
        },
        {
          "name": "Get Dispute Detail by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/disputes/:dispute_id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "disputes",
                ":dispute_id"
              ],
              "variable": [
                {
                  "key": "dispute_id",
                  "value": "disp_test_998811",
                  "description": "Razorpay dispute ID"
                }
              ]
            },
            "description": "Fetch full audit trail, courier telemetry, and compiled evidence packet for a specific dispute."
          },
          "response": []
        },
        {
          "name": "Manual Operator Override",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Admin-Token",
                "value": "{{adminToken}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"contest\",\n  \"operator_note\": \"Courier confirmed delivery signature match. Proceed with contestation.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/disputes/:dispute_id/override",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "disputes",
                ":dispute_id",
                "override"
              ],
              "variable": [
                {
                  "key": "dispute_id",
                  "value": "disp_test_998811",
                  "description": "Razorpay dispute ID to override"
                }
              ]
            },
            "description": "Authenticate via X-Admin-Token and force a dispute transition to MANUALLY_CONTESTED or MANUALLY_ACCEPTED."
          },
          "response": []
        },
        {
          "name": "Simulate Dispute Scenario",
          "request": {
            "method": "POST",
            "header": [
