# ==============================================================================
# Razorpay Dispute Defender — Environment Configuration
# ==============================================================================

# Application Environment (development | staging | production)
# In production, missing RAZORPAY_WEBHOOK_SECRET or RAZORPAY keys will cause immediate startup failure.
APP_ENV=development

# Logging output level (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# Transactional database connection string (SQLite WAL mode or PostgreSQL)
DATABASE_URL=sqlite:///./data/mock_db/disputes.db

# Path to the centralized, declarative scoring policy YAML definition
SCORING_POLICY_PATH=./app/policy/scoring_policy.yaml

# Local directory where ChromaDB persistent vector collections are stored
CHROMADB_PATH=./data/mock_db/chroma_db

# Razorpay API Credentials (required for Document upload and Dispute contest/accept endpoints)
RAZORPAY_KEY_ID=rzp_test_51ZDefenderMock
RAZORPAY_KEY_SECRET=secret_test_mockkey998877

# Razorpay Webhook Secret used to verify HMAC-SHA256 signatures on X-Razorpay-Signature
RAZORPAY_WEBHOOK_SECRET=whsec_mockdisputeshield123

# Toggle mock mode for zero-cost testing and simulation (true | false)
RAZORPAY_MOCK_MODE=true

# Static shared secret token for human operator overrides (X-Admin-Token header)
ADMIN_OVERRIDE_TOKEN=admin_secret_token_override_99

# Google Gemini API key for vision/LLM OCR manifest extraction and chat RAG (optional)
GEMINI_API_KEY=

# Durable Queue Worker polling cadence in seconds
AUDIT_WORKER_POLL_INTERVAL_SECONDS=2.0

# Lease timeout in seconds before an in-flight audit job is reclaimed after a worker crash
AUDIT_JOB_LEASE_SECONDS=300
